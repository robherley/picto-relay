+static a_bool_t
+ath_tgt_picto_arm_frame(struct ieee80211_frame *wh, a_int32_t len)
+{
+	a_uint8_t *data = (a_uint8_t *)wh;
+	a_uint8_t marker;
+	a_uint8_t slot_marker;
+
+	picto_arm_state = 0x04;
+	if (len < (a_int32_t)sizeof(struct ieee80211_frame) + 2)
+		return AH_FALSE;
+	picto_arm_state = 0x05;
+	if ((wh->i_fc[0] & IEEE80211_FC0_TYPE_MASK) != IEEE80211_FC0_TYPE_DATA)
+		return AH_FALSE;
+	picto_arm_state = 0x06;
+	if (!IEEE80211_ADDR_EQ(wh->i_addr3, picto_client_reply))
+		return AH_FALSE;
+
+	picto_arm_state = 0x09;
+	marker = data[len - 2];
+	slot_marker = data[len - 1];
+	if ((slot_marker & 0xf0) != 0xb0)
+		return AH_FALSE;
+
+	if (marker == 0xaf)
+		picto_arm_template = PICTO_REPLY_DISARM;
+	else if (marker == 0xae) {
+		if (len < (a_int32_t)sizeof(struct ieee80211_frame) + 4 ||
+		    data[sizeof(struct ieee80211_frame)] == 0)
+			return AH_FALSE;
+		picto_arm_template = PICTO_REPLY_COMMIT;
+		picto_staged_message_total =
+			data[sizeof(struct ieee80211_frame)];
+	}
+	else if ((marker & 0xf0) == 0xa0 &&
+		 (marker & 0x0f) < PICTO_IDENTITY_REPLY_COUNT)
+		picto_arm_template = marker & 0x0f;
+	else if ((marker & 0xf0) == 0xc0)
+		picto_arm_template = PICTO_REPLY_MESSAGE_BASE + (marker & 0x0f);
+	else
+		return AH_FALSE;
+	picto_client_mask = 1 << (slot_marker & 0x0f);
+	adf_os_mem_copy(picto_host, wh->i_addr1, IEEE80211_ADDR_LEN);
+	adf_os_mem_copy(picto_station, wh->i_addr2, IEEE80211_ADDR_LEN);
+	picto_arm_state = 0x0f;
+	/* Runtime message templates are loaded while the station remains live.
+	 * Identity activation and disarm still reset the responder atomically. */
+	if (picto_arm_template < PICTO_REPLY_MESSAGE_BASE ||
+	    picto_arm_template == PICTO_REPLY_DISARM) {
+		picto_replies_active = AH_FALSE;
+		if (picto_arm_template == PICTO_REPLY_DISARM)
+			picto_cleanup_pending = AH_TRUE;
+		else
+			picto_inflight_buf = NULL;
+		picto_completion_unreported = AH_FALSE;
+		picto_last_tx_clean = AH_FALSE;
+	}
+	return picto_client_mask != 0;
+}
+
+static void
+ath_tgt_picto_configure_queue(struct ath_softc_tgt *sc, struct ath_txq *txq)
+{
+	a_uint32_t q = txq->axq_qnum;
+
+	/* Nintendo clients answer a host poll at the first SIFS boundary.  A
+	 * normal best-effort queue waits AIFS plus random contention backoff and
+	 * therefore misses the host's reply window.  This adapter is dedicated to
+	 * Picto Relay while armed, so make its reply queue deterministic. */
+	OS_REG_RMW_FIELD(sc->sc_ah, AR_DLCL_IFS(q),
+			 AR_D_LCL_IFS_CWMIN, 0);
+	OS_REG_RMW_FIELD(sc->sc_ah, AR_DLCL_IFS(q),
+			 AR_D_LCL_IFS_CWMAX, 0);
+	OS_REG_RMW_FIELD(sc->sc_ah, AR_DLCL_IFS(q),
+			 AR_D_LCL_IFS_AIFS, 0);
+	OS_REG_SET_BIT(sc->sc_ah, AR_DIAG_SW, AR_DIAG_IGNORE_VIRT_CS);
+	OS_REG_SET_BIT(sc->sc_ah, AR_D_GBL_IFS_MISC,
+			 AR_D_GBL_IFS_MISC_IGNORE_BACKOFF);
+}
+
+static void
+ath_tgt_picto_release_replies(struct ath_softc_tgt *sc)
+{
+	struct ath_tx_buf *retained;
+	a_uint8_t template;
+
+	if (!picto_cleanup_pending || picto_inflight_buf)
+		return;
+	picto_cleanup_pending = AH_FALSE;
+	picto_message_pending = AH_FALSE;
+	picto_message_index = 0;
+	picto_message_total = 0;
+	picto_message_awaiting_ack = AH_FALSE;
+	for (template = 0; template < PICTO_REPLY_COUNT; template++) {
+		retained = picto_reply_bufs[template];
+		picto_reply_bufs[template] = NULL;
+		picto_reply_txqs[template] = NULL;
+		picto_reply_ready[template] = AH_FALSE;
+		if (retained)
+			ath_tgt_tx_comp_normal(sc, retained);
+	}
+}
+
+static void
+ath_tgt_picto_tx_complete(struct ath_softc_tgt *sc, struct ath_tx_buf *bf)
+{
+	struct ieee80211_frame *wh;
+	a_uint8_t *data;
+	a_uint8_t template;
+	a_bool_t transmitted_reply;
+	if (bf == picto_disarm_buf) {
+		picto_disarm_buf = NULL;
+		ath_tgt_tx_comp_normal(sc, bf);
+		ath_tgt_picto_release_replies(sc);
+		return;
+	}
+	if (bf == picto_commit_buf) {
+		picto_commit_buf = NULL;
+		if (picto_replies_active && picto_protocol_state == PICTO_STATE_STEADY) {
+			picto_message_total = picto_staged_message_total;
+			picto_message_index = 0;
+			picto_message_awaiting_ack = AH_FALSE;
+			picto_message_pending = picto_message_total != 0;
+		}
+		ath_tgt_tx_comp_normal(sc, bf);
+		return;
+	}
+
+	for (template = 0; template < PICTO_REPLY_COUNT; template++)
+		if (picto_reply_bufs[template] == bf)
+			break;
+	if (template == PICTO_REPLY_COUNT)
+		return;
+
+	transmitted_reply = bf == picto_inflight_buf;
+	if (transmitted_reply) {
+		picto_inflight_buf = NULL;
+		picto_last_tx_clean = bf->bf_lastds->ds_txstat.ts_status == 0;
+		picto_last_queue_delay = picto_queue_delay;
+		picto_last_tx_delay =
+			bf->bf_lastds->ds_txstat.ts_tstamp - picto_poll_timestamp;
+		picto_completion_unreported = AH_TRUE;
+	}
+	/* Drawing buffers stay retained until the host acknowledgement says
+	 * whether this logical reply was accepted or must be retried. */
+	if (template >= PICTO_REPLY_MESSAGE_BASE && transmitted_reply) {
+		picto_message_awaiting_ack = AH_TRUE;
+		return;
+	}
+	wh = ATH_SKB2_WH(bf->bf_skb);
+	data = (a_uint8_t *)wh;
+	adf_os_mem_copy(wh->i_addr1, picto_host, IEEE80211_ADDR_LEN);
+	adf_os_mem_copy(wh->i_addr2, picto_station, IEEE80211_ADDR_LEN);
+	adf_os_mem_copy(wh->i_addr3, picto_client_reply, IEEE80211_ADDR_LEN);
+	if (adf_nbuf_len(bf->bf_skb) >= sizeof(struct ieee80211_frame) + 2) {
+		data[sizeof(struct ieee80211_frame)] = picto_arm_prefix[template][0];
+		data[sizeof(struct ieee80211_frame) + 1] = picto_arm_prefix[template][1];
+	}
+	bf->bf_ismcast = AH_FALSE;
+	ath_tgt_picto_prepare_reply(sc, bf);
+	ath_tgt_picto_release_replies(sc);
+}
+
+static void
+ath_tgt_picto_refresh_reply(struct ath_tx_buf *bf, adf_nbuf_t source,
+			    a_uint8_t template)
+{
+	adf_nbuf_t destination = bf->bf_skb;
+	struct ieee80211_frame *wh;
+	a_uint8_t *data;
+	a_uint32_t destination_len = adf_nbuf_len(destination);
+	a_uint32_t source_len = adf_nbuf_len(source);
+
+	if (source_len > destination_len)
+		adf_nbuf_put_tail(destination, source_len - destination_len);
+	else if (destination_len > source_len)
+		adf_nbuf_trim_tail(destination, destination_len - source_len);
+	adf_os_mem_copy(ATH_SKB2_WH(destination), ATH_SKB2_WH(source),
+			 source_len);
+	wh = ATH_SKB2_WH(destination);
+	data = (a_uint8_t *)wh;
+	data[sizeof(struct ieee80211_frame)] = picto_arm_prefix[template][0];
+	data[sizeof(struct ieee80211_frame) + 1] =
+		picto_arm_prefix[template][1];
+	bf->bf_ismcast = AH_FALSE;
+}
+
+static void
+ath_tgt_picto_prepare_reply(struct ath_softc_tgt *sc, struct ath_tx_buf *bf)
+{
+	struct ath_hal *ah = sc->sc_ah;
+	struct ath_tx_desc *ds;
+	struct ieee80211_frame *wh;
+	const HAL_RATE_TABLE *rt = sc->sc_currates;
+	HAL_11N_RATE_SERIES series[4] = {{ 0 }};
+	a_uint8_t template;
+	a_uint8_t txrate;
+	a_uint32_t flags;
+	a_int32_t pktlen;
+
+	if (!bf || !rt)
+		return;
+	for (template = 0; template < PICTO_REPLY_COUNT; template++)
+		if (picto_reply_bufs[template] == bf)
+			break;
+	if (template == PICTO_REPLY_COUNT)
+		return;
+
+	wh = ATH_SKB2_WH(bf->bf_skb);
+	ds = bf->bf_desc;
+	pktlen = adf_nbuf_len(bf->bf_skb) + IEEE80211_CRC_LEN;
+	txrate = rt->info[1].rateCode | rt->info[1].shortPreamble;
+	flags = HAL_TXDESC_CLRDMASK | HAL_TXDESC_NOACK | HAL_TXDESC_INTREQ;
+
+	ah->ah_setupTxDesc(ds, pktlen, ieee80211_anyhdrsize(wh),
+			       HAL_PKT_TYPE_NORMAL, 60, txrate, 1,
+			       HAL_TXKEYIX_INVALID, flags, 0, 0);
+	ath_filltxdesc(sc, bf);
+	series[0].Tries = 1;
+	series[0].Rate = txrate;
+	series[0].ChSel = sc->sc_ic.ic_tx_chainmask;
+	ah->ah_set11nRateScenario(ds, 0, 0, series, 4, 0);
+	picto_reply_ready[template] = AH_TRUE;
+}
+
+static void
+ath_tgt_picto_queue_reply(struct ath_softc_tgt *sc, a_uint8_t template)
+{
+	struct ath_tx_buf *bf;
+	struct ath_txq *txq;
+	struct ieee80211_frame *wh;
+	a_uint16_t sequence;
+
+	if (template >= PICTO_REPLY_COUNT)
+		return;
+	bf = picto_reply_bufs[template];
+	txq = picto_reply_txqs[template];
+	if (!picto_reply_ready[template] || !bf || !txq || picto_inflight_buf)
+		return;
+
+	picto_reply_ready[template] = AH_FALSE;
+	picto_inflight_buf = bf;
+	wh = ATH_SKB2_WH(bf->bf_skb);
+	sequence = picto_tx_sequence << IEEE80211_SEQ_SEQ_SHIFT;
+	wh->i_seq[0] = sequence & 0xff;
+	wh->i_seq[1] = sequence >> 8;
+	INCR(picto_tx_sequence, IEEE80211_SEQ_MAX);
+	picto_queue_delay =
+		(a_uint32_t)sc->sc_ah->ah_getTsf64(sc->sc_ah) - picto_poll_timestamp;
+	if (picto_queue_delay > 0x0fff)
+		picto_queue_delay = 0x0fff;
+	ath_tgt_txqaddbuf(sc, txq, bf, bf->bf_lastds);
+}
+
+static void
+ath_tgt_picto_message_ack(struct ath_softc_tgt *sc,
+			  a_uint16_t failed_client_mask)
+{
+	struct ath_tx_buf *bf;
+	a_uint8_t template;
+
+	if (!picto_message_awaiting_ack ||
+	    picto_message_index >= picto_message_total)
+		return;
+	template = PICTO_REPLY_MESSAGE_BASE +
+		(picto_message_index % PICTO_MESSAGE_REPLY_COUNT);
+	bf = picto_reply_bufs[template];
+	if (!bf)
+		return;
+
+	/* A failed bit means the host did not accept this slot's reply.  Keep the
+	 * logical cursor fixed and make the same DMA buffer eligible again. */
+	if (failed_client_mask & picto_client_mask) {
+		picto_message_awaiting_ack = AH_FALSE;
+		ath_tgt_picto_prepare_reply(sc, bf);
+		return;
+	}
+
+	/* The host accepted the reply.  Keep this physical buffer allocated but
+	 * unavailable; Linux's next refill copies new bytes into it in place.  The
+	 * temporary refill upload then completes normally and returns its HTC
+	 * credit, so a drawing can wrap around the ring indefinitely. */
+	picto_message_awaiting_ack = AH_FALSE;
+	picto_reply_ready[template] = AH_FALSE;
+	picto_message_index++;
+	if (picto_message_index >= picto_message_total)
+		picto_message_pending = AH_FALSE;
+}
+
+static a_uint8_t
+ath_tgt_picto_select_reply(a_uint8_t *data, a_uint32_t len)
+{
+	a_uint16_t packet_id;
+
+	if (len < sizeof(struct ieee80211_frame) + 6)
+		return PICTO_REPLY_IDLE;
+	packet_id = data[28] | ((a_uint16_t)data[29] << 8);
+	packet_id &= 0x7fff;
+
+	if (picto_protocol_state == PICTO_STATE_WAIT_SESSION &&
+	    packet_id == 0x1c34 && picto_reply_ready[PICTO_REPLY_SESSION] &&
+	    !picto_inflight_buf) {
+		picto_protocol_state = PICTO_STATE_WAIT_INITIAL_HOST_PROFILE;
+		return PICTO_REPLY_SESSION;
+	}
+	if (picto_protocol_state == PICTO_STATE_WAIT_INITIAL_HOST_PROFILE &&
+	    packet_id == 0x1e30 && len > 43 && data[42] == 3 && data[43] == 0 &&
+	    picto_reply_ready[PICTO_REPLY_INITIAL_ANNOUNCE] &&
+	    !picto_inflight_buf) {
+		picto_protocol_state = PICTO_STATE_WAIT_INITIAL_ANNOUNCE_ECHO;
+		return PICTO_REPLY_INITIAL_ANNOUNCE;
+	}
+	if (picto_protocol_state == PICTO_STATE_WAIT_INITIAL_ANNOUNCE_ECHO &&
+	    packet_id == 0x1d0a && picto_reply_ready[PICTO_REPLY_EMPTY] &&
+	    !picto_inflight_buf) {
+		picto_protocol_state = PICTO_STATE_WAIT_INITIAL_PROFILE_REQUEST;
+		return PICTO_REPLY_EMPTY;
+	}
+	if (picto_protocol_state == PICTO_STATE_WAIT_INITIAL_PROFILE_REQUEST &&
+	    packet_id == 0x1d0a &&
+	    picto_reply_ready[PICTO_REPLY_INITIAL_PROFILE] &&
+	    !picto_inflight_buf) {
+		picto_protocol_state = PICTO_STATE_WAIT_INITIAL_ECHO;
+		return PICTO_REPLY_INITIAL_PROFILE;
+	}
+	if (picto_protocol_state == PICTO_STATE_WAIT_INITIAL_ECHO &&
+	    packet_id == 0x1e30 && len > 43 && data[42] == 3 && data[43] == 0) {
+		picto_protocol_state = PICTO_STATE_WAIT_INITIAL_COMPLETE_GATE;
+		return PICTO_REPLY_IDLE;
+	}
+	if (picto_protocol_state == PICTO_STATE_WAIT_INITIAL_COMPLETE_GATE &&
+	    packet_id == 0x1c34 && picto_reply_ready[PICTO_REPLY_EMPTY] &&
+	    !picto_inflight_buf) {
+		picto_protocol_state = PICTO_STATE_WAIT_INITIAL_COMPLETE;
+		return PICTO_REPLY_EMPTY;
+	}
+	if (picto_protocol_state == PICTO_STATE_WAIT_INITIAL_COMPLETE &&
+	    packet_id == 0x1c34 &&
+	    picto_reply_ready[PICTO_REPLY_INITIAL_COMPLETE] &&
+	    !picto_inflight_buf) {
+		picto_protocol_state = PICTO_STATE_WAIT_REPEAT_ANNOUNCE;
+		return PICTO_REPLY_INITIAL_COMPLETE;
+	}
+	if (picto_protocol_state == PICTO_STATE_WAIT_REPEAT_ANNOUNCE &&
+	    packet_id == 0x1d0a &&
+	    picto_reply_ready[PICTO_REPLY_REPEAT_ANNOUNCE] &&
+	    !picto_inflight_buf) {
+		picto_protocol_state = PICTO_STATE_WAIT_FINAL_HOST_PROFILE;
+		return PICTO_REPLY_REPEAT_ANNOUNCE;
+	}
+	if (picto_protocol_state == PICTO_STATE_WAIT_FINAL_HOST_PROFILE &&
+	    packet_id == 0x1e30 && len > 43 && data[42] == 3 && data[43] == 1 &&
+	    picto_reply_ready[PICTO_REPLY_EMPTY] &&
+	    !picto_inflight_buf) {
+		picto_protocol_state = PICTO_STATE_WAIT_FINAL_PROFILE;
+		return PICTO_REPLY_EMPTY;
+	}
+	if (picto_protocol_state == PICTO_STATE_WAIT_FINAL_PROFILE &&
+	    packet_id == 0x1c34 &&
+	    picto_reply_ready[PICTO_REPLY_FINAL_PROFILE] &&
+	    !picto_inflight_buf) {
+		picto_protocol_state = PICTO_STATE_WAIT_FINAL_ECHO;
+		return PICTO_REPLY_FINAL_PROFILE;
+	}
+	if (picto_protocol_state == PICTO_STATE_WAIT_FINAL_ECHO &&
+	    packet_id == 0x1e30 && len > 43 && data[42] == 3 && data[43] == 1) {
+		picto_protocol_state = PICTO_STATE_WAIT_FINAL_COMPLETE;
+		return PICTO_REPLY_IDLE;
+	}
+	if (picto_protocol_state == PICTO_STATE_WAIT_FINAL_COMPLETE &&
+	    packet_id == 0x1c34 &&
+	    picto_reply_ready[PICTO_REPLY_FINAL_COMPLETE] &&
+	    !picto_inflight_buf) {
+		picto_protocol_state = PICTO_STATE_STEADY;
+		return PICTO_REPLY_FINAL_COMPLETE;
+	}
+	if (picto_protocol_state == PICTO_STATE_STEADY &&
+	    picto_message_pending && !picto_message_awaiting_ack &&
+	    !picto_inflight_buf) {
+		a_uint8_t template = PICTO_REPLY_MESSAGE_BASE +
+			(picto_message_index % PICTO_MESSAGE_REPLY_COUNT);
+		if (picto_reply_ready[template])
+			return template;
+	}
+	return PICTO_REPLY_IDLE;
+}
+
+void
+ath_tgt_picto_rx(struct ath_softc_tgt *sc, adf_nbuf_t skb,
+		 struct ath_rx_status *rx_status)
+{
+	static const a_uint8_t host_to_client[IEEE80211_ADDR_LEN] =
+		{ 0x03, 0x09, 0xbf, 0x00, 0x00, 0x00 };
+	static const a_uint8_t client_ack[IEEE80211_ADDR_LEN] =
+		{ 0x03, 0x09, 0xbf, 0x00, 0x00, 0x03 };
+	a_uint8_t *data;
+	a_uint32_t len;
+	struct ieee80211_frame *wh;
+	a_uint16_t client_mask;
+	a_uint8_t diagnostic;
+	a_uint8_t template;
+
+	if (!rx_status)
+		return;
+
+	adf_nbuf_peek_header(skb, &data, &len);
+	if (len < sizeof(struct ieee80211_frame) + 4)
+		return;
+	wh = (struct ieee80211_frame *)data;
+	if ((wh->i_fc[0] & IEEE80211_FC0_TYPE_MASK) != IEEE80211_FC0_TYPE_DATA)
+		return;
+	if (IEEE80211_ADDR_EQ(wh->i_addr1, client_ack)) {
+		if (picto_replies_active &&
+		    IEEE80211_ADDR_EQ(wh->i_addr2, picto_host)) {
+			client_mask = data[26] | ((a_uint16_t)data[27] << 8);
+			ath_tgt_picto_message_ack(sc, client_mask);
+		}
+		return;
+	}
+	if (!IEEE80211_ADDR_EQ(wh->i_addr1, host_to_client))
+		return;
+	if (!picto_replies_active || !picto_reply_bufs[PICTO_REPLY_IDLE]) {
+		diagnostic = picto_arm_state;
+		goto mark;
+	}
+	if (!IEEE80211_ADDR_EQ(wh->i_addr2,
+				 ATH_SKB2_WH(picto_reply_bufs[PICTO_REPLY_IDLE]->bf_skb)->i_addr1)) {
+		diagnostic = 0x0b; /* Poll source differs from armed host. */
+		goto mark;
+	}
+
+	client_mask = data[26] | ((a_uint16_t)data[27] << 8);
+	/* Never substitute an idle reply while a drawing acknowledgement remains
+	 * unresolved. Host commands and acknowledgements can be pipelined, so the
+	 * prior drawing may already have arrived; a duplicate drawing fragment is
+	 * nevertheless safe, while acknowledging an idle substitute can incorrectly
+	 * advance the drawing cursor past a fragment the host never received. */
+	if (picto_message_awaiting_ack)
+		ath_tgt_picto_message_ack(sc, picto_client_mask);
+	if (!(client_mask & picto_client_mask)) {
+		diagnostic = 0x0c; /* Armed slot differs from targeted slot. */
+		goto mark;
+	}
+
+	diagnostic = PICTO_DIAG_PREFIX;
+	if (picto_completion_unreported) {
+		diagnostic |= PICTO_DIAG_COMPLETED;
+		if (picto_last_tx_clean)
+			diagnostic |= PICTO_DIAG_TX_CLEAN;
+		wh->i_dur[0] = picto_last_tx_delay & 0xff;
+		wh->i_dur[1] = picto_last_tx_delay >> 8;
+		picto_completion_unreported = AH_FALSE;
+	}
+	template = ath_tgt_picto_select_reply(data, len);
+	if (picto_reply_ready[template] && !picto_inflight_buf) {
+		diagnostic |= PICTO_DIAG_QUEUED;
+		/* On a queued frame, BUSY is repurposed to identify a drawing reply.
+		 * On an unqueued frame it retains its original busy meaning. */
+		if (template >= PICTO_REPLY_MESSAGE_BASE)
+			diagnostic |= PICTO_DIAG_BUSY;
+		picto_poll_timestamp = rx_status->rs_tstamp;
+		ath_tgt_picto_queue_reply(sc, template);
+	} else {
+		diagnostic |= PICTO_DIAG_BUSY;
+	}
+mark:
+	/* Export the cumulative accepted-reply cursor on every subsequent host
+	 * command. Linux can therefore recover from monitor-frame loss and refill
+	 * every freed ring slot without pairing individual poll/ACK captures. */
+	if (picto_message_total != 0) {
+		wh->i_dur[0] = picto_message_index;
+		wh->i_dur[1] = PICTO_MESSAGE_CURSOR_PREFIX >> 8;
+	}
+	/* Some ath9k_htc hosts do not export rs_antenna to radiotap.  Mirror the
+	 * four diagnostic bits into the captured copy's fragment-number nibble.
+	 * Hardware has already received and verified this frame, so this changes
+	 * neither the over-the-air poll nor the DS host's behavior. */
+	if (diagnostic & PICTO_DIAG_COMPLETED) {
+		a_uint16_t encoded =
+			(picto_last_queue_delay << 4) | (diagnostic & 0x0f);
+		wh->i_seq[0] = encoded & 0xff;
+		wh->i_seq[1] = encoded >> 8;
+	} else {
+		wh->i_seq[0] = (wh->i_seq[0] & 0xf0) | (diagnostic & 0x0f);
+	}
+	rx_status->rs_antenna = diagnostic;
+}
+
